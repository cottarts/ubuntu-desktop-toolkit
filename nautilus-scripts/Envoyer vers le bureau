#!/usr/bin/env python3
from pathlib import Path
import os, subprocess

def message(text):
    subprocess.run(['zenity', '--error', '--text=' + text])

files = [Path(p) for p in os.environ.get('NAUTILUS_SCRIPT_SELECTED_FILE_PATHS', '').splitlines() if p]
if not files:
    message('Sélectionnez au moins un fichier ou dossier local.')
    raise SystemExit(1)

desktop = Path(subprocess.check_output(['xdg-user-dir', 'DESKTOP'], text=True).strip())
desktop.mkdir(parents=True, exist_ok=True)
for source in files:
    target = desktop / source.name
    count = 1
    while target.exists() or target.is_symlink():
        target = desktop / (source.name + ' — raccourci ' + str(count))
        count += 1
    try:
        target.symlink_to(source.absolute(), target_is_directory=source.is_dir())
    except OSError as error:
        message(str(error))

#!/usr/bin/env python3
from pathlib import Path
import os, subprocess, shutil
def error(text):
    subprocess.run(['zenity', '--error', '--text=' + text])
files = [Path(p) for p in os.environ.get('NAUTILUS_SCRIPT_SELECTED_FILE_PATHS', '').splitlines() if p]
if not files:
    error('Sélectionnez des fichiers ou dossiers locaux.')
    raise SystemExit(1)

text = '\n'.join(str(p.absolute()) for p in files)
if os.environ.get('WAYLAND_DISPLAY') and shutil.which('wl-copy'):
    command = ['wl-copy', '--type', 'text/plain;charset=utf-8']
elif shutil.which('xclip'):
    command = ['xclip', '-selection', 'clipboard']
else:
    error('L’outil de presse-papiers doit être installé.')
    raise SystemExit(1)
result = subprocess.run(command, input=text, text=True)
if result.returncode:
    error('Impossible de copier les chemins dans le presse-papiers.')

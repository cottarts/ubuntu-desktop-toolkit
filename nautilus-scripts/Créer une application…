#!/usr/bin/python3
import hashlib
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

def dialog(*args):
    result = subprocess.run(['zenity', *args], text=True, capture_output=True)
    if result.returncode:
        raise SystemExit(0)
    return result.stdout.strip()

def escape(value):
    return str(value).replace('\\', '\\\\').replace('\n', '\\n').replace('\r', '\\r').replace('\t', '\\t')

def exec_quote(value):
    value = str(value).replace('%', '%%')
    for char in ('\\', '"', '`', '$'):
        value = value.replace(char, '\\' + char)
    return escape('"' + value + '"')

def main():
    files = [Path(p) for p in os.environ.get('NAUTILUS_SCRIPT_SELECTED_FILE_PATHS', '').splitlines() if p]
    if len(files) != 1 or not files[0].is_file():
        raise ValueError('Sélectionnez un seul fichier AppImage ou un programme local.')
    source = files[0].absolute()
    default = re.split(r'-\d', source.stem)[0].capitalize()
    name = dialog('--entry', '--title=Créer une application', '--text=Nom à afficher dans le menu des applications :', '--entry-text=' + default)
    if not name or '\n' in name or '\r' in name:
        raise ValueError('Le nom doit être renseigné sur une seule ligne.')
    icon = Path(dialog('--file-selection', '--title=Choisir une icône', '--file-filter=Images | *.png *.svg *.ico *.jpg *.jpeg *.webp *.PNG *.SVG *.ICO', '--file-filter=Tous les fichiers | *'))
    if not icon.is_file():
        raise ValueError('L’icône sélectionnée est introuvable.')
    data = Path(os.environ.get('XDG_DATA_HOME', str(Path.home() / '.local/share')))
    identifier = 'custom-app-' + hashlib.sha256((str(source) + '\0' + name).encode()).hexdigest()[:16]
    applications = data / 'applications'
    icons = data / 'icons' / 'custom-apps'
    applications.mkdir(parents=True, exist_ok=True)
    icons.mkdir(parents=True, exist_ok=True)
    target = applications / (identifier + '.desktop')
    if target.exists():
        dialog('--question', '--title=Application existante', '--text=Une entrée existe déjà pour ce fichier et ce nom. La remplacer ?')
    saved_icon = icons / (identifier + icon.suffix.lower())
    if icon.resolve() != saved_icon.resolve():
        shutil.copyfile(icon, saved_icon)
    source.chmod(source.stat().st_mode | 0o100)
    content = '\n'.join(['[Desktop Entry]', 'Type=Application', 'Version=1.0', 'Name=' + escape(name), 'Exec=' + exec_quote(source), 'Icon=' + escape(saved_icon), 'Terminal=false', 'Categories=Utility;', ''])
    temporary = target.with_suffix('.tmp.desktop')
    temporary.write_text(content, encoding='utf-8')
    validator = shutil.which('desktop-file-validate')
    if validator:
        result = subprocess.run([validator, str(temporary)], capture_output=True, text=True)
        if result.returncode:
            temporary.unlink(missing_ok=True)
            raise ValueError(result.stdout + result.stderr)
    temporary.replace(target)
    updater = shutil.which('update-desktop-database')
    if updater:
        subprocess.run([updater, str(applications)], capture_output=True)
    dialog('--info', '--title=Application créée', '--text=' + name + ' est disponible dans le menu des applications.\nConservez le programme à cet emplacement :\n' + str(source))

if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        subprocess.run(['zenity', '--error', '--title=Création impossible', '--text=' + str(error)])
        sys.exit(1)
